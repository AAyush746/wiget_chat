generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Platform staff. `role` is the *global* authority of the account (ADMIN vs
/// AGENT); which tenants an AGENT may actually work on lives in
/// WebsiteMembership, not here.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  name         String?
  role         Role     @default(AGENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  currentConversations Conversation[]           @relation("CurrentAgent")
  assignments          ConversationAssignment[] @relation("AssignmentAgent")
  createdAssignments   ConversationAssignment[] @relation("AssignmentActor")
  messages             Message[]                @relation("AgentSender")
  events               ConversationEvent[]      @relation("EventActorUser")
  memberships          WebsiteMembership[]

  @@index([role, isActive])
  @@map("users")
}

/// A customer/tenant website that embeds the ChatFlow widget. This is the
/// tenant boundary: every visitor, conversation and event belongs to exactly
/// one website.
///
/// `publicKey` is the *public* widget credential: a high-entropy random value
/// generated by the application (32 random bytes, base64url) that identifies
/// the tenant in public widget URLs. It is safe to publish — unlike a
/// database id it is not enumerable, and it can be rotated in a later phase
/// if ever compromised. It is never regenerated implicitly, and deactivating
/// a website (rather than deleting it) is what suspends widget access.
model Website {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  domain    String   @unique
  publicKey String   @unique @default(uuid()) @map("public_key")
  isActive  Boolean  @default(true) @map("is_active")
  /// Whether the automatic AI assistant may reply to visitors on this site.
  aiEnabled       Boolean @default(false) @map("ai_enabled")
  /// Optional pre-written reply used when the AI escalates without an answer.
  aiFallbackMessage String? @map("ai_fallback_message")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  visitors     Visitor[]
  memberships  WebsiteMembership[]
  faqs         FaqEntry[]

  @@map("websites")
}

/// Which websites a staff user is allowed to work on. Membership is the
/// per-tenant counterpart of the global `User.role`: an AGENT may hold any
/// number of memberships, each independently activated or deactivated.
/// Deactivating (or deleting) a membership revokes future access only —
/// conversations and messages already written are never touched.
model WebsiteMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  websiteId String   @map("website_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([userId, websiteId])
  @@index([websiteId])
  @@map("website_memberships")
}

/// One Q&A entry in a website's AI knowledge base (tenant-scoped). The AI
/// assistant answers routine questions only from these entries; anything the
/// provider cannot ground in this content is escalated to a human.
model FaqEntry {
  id        String   @id @default(uuid()) @db.Uuid
  websiteId String   @map("website_id") @db.Uuid
  question  String
  answer    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt])
  @@map("faq_entries")
}

/// An anonymous or identified end user of a website. `visitorKey` is a stable
/// token stored by the widget, so a page refresh rehydrates the same visitor
/// (and therefore the same conversation) instead of creating a new identity.
model Visitor {
  id         String   @id @default(uuid()) @db.Uuid
  websiteId  String   @map("website_id") @db.Uuid
  visitorKey String   @map("visitor_key")
  name       String?
  email      String?
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  website       Website             @relation(fields: [websiteId], references: [id], onDelete: Restrict)
  conversations Conversation[]
  messages      Message[]           @relation("VisitorSender")
  events        ConversationEvent[] @relation("EventActorVisitor")

  @@unique([websiteId, visitorKey])
  /// `(id, websiteId)` is the target of Conversation's composite foreign key,
  /// which is what makes `conversation.websiteId === visitor.websiteId` a
  /// database-level guarantee rather than a service-layer convention.
  @@unique([id, websiteId])
  @@map("visitors")
}

/// A single chat thread. `websiteId` is denormalized from the visitor so that
/// every tenant-scoped inbox query (and its index) can filter by website
/// without joining. It is kept equal to `visitor.websiteId` by a composite
/// foreign key over `(visitorId, websiteId)` -> `visitors(id, website_id)`, so
/// the database rejects any conversation whose website does not match its
/// visitor's website.
model Conversation {
  id               String             @id @default(uuid()) @db.Uuid
  websiteId        String             @map("website_id") @db.Uuid
  visitorId        String             @map("visitor_id") @db.Uuid
  assignedAgentId  String?            @map("assigned_agent_id") @db.Uuid
  status           ConversationStatus @default(OPEN)
  /// Who is responsible for replying: the AI assistant, a human agent, or the
  /// AI after it (or the visitor) requested a handoff that is still pending.
  handling            HandlingMode @default(AI)
  /// When a handoff to a human was last requested (null = never / released).
  handoffRequestedAt DateTime?    @map("handoff_requested_at") @db.Timestamptz(3)
  /// Recorded escalation code (VISITOR_REQUESTED, UNSUPPORTED,
  /// LOW_CONFIDENCE, AI_FAILURE, LIMIT_REACHED) — staff-facing only.
  handoffReason    String?  @map("handoff_reason")
  subject          String?
  lastMessageAt    DateTime?          @map("last_message_at") @db.Timestamptz(3)
  closedAt         DateTime?          @map("closed_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  visitor       Visitor                  @relation(fields: [visitorId, websiteId], references: [id, websiteId], onDelete: Restrict)
  assignedAgent User?                    @relation("CurrentAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages      Message[]
  assignments   ConversationAssignment[]
  events        ConversationEvent[]
  aiJobs        AiJob[]

  @@unique([id, websiteId])
  @@index([websiteId, status, lastMessageAt])
  @@index([assignedAgentId, status, lastMessageAt])
  @@map("conversations")
}

/// Messages are immutable. `senderType` is the source of truth; `visitorId` /
/// `userId` are optional references kept for joining back to the actor. A raw
/// SQL CHECK constraint (see the migration) enforces that the reference matches
/// the sender type.
///
/// `clientMessageId` is an *optional* client-generated idempotency key: a
/// retried send (lost WebSocket ack, HTTP retry) that carries the same key
/// resolves to the original row instead of inserting a duplicate — enforced by
/// a unique `(conversationId, clientMessageId)` constraint. Rows without a key
/// (plain REST calls, system messages) are unaffected: Postgres treats NULLs
/// as distinct in unique indexes. No delivery/edit/delete state is stored —
/// messages are immutable and delivery is transport-level, not durable state.
model Message {
  id              String        @id @default(uuid()) @db.Uuid
  conversationId  String        @map("conversation_id") @db.Uuid
  senderType      MessageSender @map("sender_type")
  visitorId       String?       @map("visitor_id") @db.Uuid
  userId          String?       @map("user_id") @db.Uuid
  content         String
  clientMessageId String?       @map("client_message_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  visitor      Visitor?     @relation("VisitorSender", fields: [visitorId], references: [id], onDelete: Restrict)
  user         User?        @relation("AgentSender", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Append-only assignment history. A row is opened when an agent is assigned
/// and stamped with `unassignedAt` when they are removed, so a conversation's
/// full routing history survives. A partial unique index (see the migration)
/// guarantees at most one open assignment per conversation.
model ConversationAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  assignedById   String?   @map("assigned_by_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  unassignedAt   DateTime? @map("unassigned_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("AssignmentAgent", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy   User?        @relation("AssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([conversationId, assignedAt])
  @@index([userId, assignedAt])
  @@map("conversation_assignments")
}

/// One durable, idempotent AI-processing work item. A job is created in the
/// *same transaction* as the visitor message it answers, so a reply is never
/// lost to a crash between insert and enqueue. `messageId` is unique — every
/// visitor message produces at most one job, and a retry resolves to it.
///
/// The worker claims a job atomically (status + lease token) and completes it
/// with the same compare-and-swap style update it used to take the lease, so
/// two processes can never both answer one question. Stale `RUNNING` leases
/// are reclaimed after a timeout, making the pipeline durable across restarts.
model AiJob {
  id             String      @id @default(uuid()) @db.Uuid
  websiteId      String      @map("website_id") @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  /// The source visitor message this job answers (unique → idempotency).
  messageId      String      @map("message_id") @db.Uuid
  status         AiJobStatus @default(PENDING)
  attempts       Int         @default(0)
  /// Earliest time the job may be (re)tried; backoff pushes this forward.
  availableAt    DateTime    @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseToken     String?     @map("lease_token") @db.Uuid
  leasedAt       DateTime?   @map("leased_at") @db.Timestamptz(3)
  lastError      String?     @map("last_error")
  replyMessageId String?     @map("reply_message_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Composite FK keeps `websiteId` equal to the conversation's website at the
  /// database level (the same tenant guarantee the other scoped tables use).
  conversation Conversation @relation(fields: [conversationId, websiteId], references: [id, websiteId], onDelete: Cascade)

  @@unique([messageId])
  @@index([websiteId, createdAt])
  @@index([status, availableAt])
  @@map("ai_jobs")
}

/// Lifecycle/audit events with enough context for future analytics. This is a
/// deliberately small append-only table, not an event-sourcing system: the
/// current state still lives on Conversation and the history on the other
/// tables. `websiteId` is denormalized so analytics can filter/aggregate by
/// tenant and time without joining conversations; a composite foreign key over
/// `(conversationId, websiteId)` keeps it equal to the conversation's website.
model ConversationEvent {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  websiteId      String                @map("website_id") @db.Uuid
  type           ConversationEventType
  actorUserId    String?               @map("actor_user_id") @db.Uuid
  actorVisitorId String?               @map("actor_visitor_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation   Conversation @relation(fields: [conversationId, websiteId], references: [id, websiteId], onDelete: Cascade)
  actorUser      User?        @relation("EventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorVisitor   Visitor?     @relation("EventActorVisitor", fields: [actorVisitorId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([websiteId, type, createdAt])
  @@map("conversation_events")
}

enum Role {
  ADMIN
  AGENT
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

/// Who is on the hook to reply to a conversation. AI messages are only ever
/// generated while handling is `AI`; any human takeover or escalation moves it
/// to `HANDOFF_PENDING`/`HUMAN`, after which the AI never replies again until
/// an authorized staff member explicitly releases the thread back to it.
enum HandlingMode {
  AI
  HANDOFF_PENDING
  HUMAN
}

enum MessageSender {
  VISITOR
  AGENT
  SYSTEM
  /// An automatic AI reply. Like `SYSTEM`, both actor references are null —
  /// it is attributed to "ChatFlow AI", never to a human agent.
  AI
}

/// Lifecycle of one AI-processing work item.
enum AiJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  /// Processing superseded (human took over, conversation closed, …).
  CANCELLED
}

enum ConversationEventType {
  CONVERSATION_CREATED
  CONVERSATION_ASSIGNED
  CONVERSATION_REASSIGNED
  AGENT_JOINED
  AGENT_LEFT
  MESSAGE_SENT
  CONVERSATION_CLOSED
  CONVERSATION_REOPENED
  VISITOR_IDENTIFIED
}
