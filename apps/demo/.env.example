# Copy to the repo root as .env.local (or .env) to configure the demo storefront
# and the widget dev host page. This app reads env files at the repo root
# (see vite.config.ts envDir).
#
# 1. Start the stack once:  npm run dev   (API + dashboard + widget)
# 2. Run `npm run demo` to seed a demo website and agent.
#    It prints a `Website publicKey` — copy that value below so the widget
#    embedded in this storefront can authenticate.

VITE_DEMO_WEBSITE_KEY=replace-with-the-public-key-from-npm-run-demo
VITE_API_URL=http://localhost:4000