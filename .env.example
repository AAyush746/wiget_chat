# --- API ---
API_PORT=4000
NODE_ENV=development

# --- Auth (Phase 3) ---
# Must be at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
# bcrypt cost factor (10-15).
BCRYPT_ROUNDS=12
# Lightweight in-memory login throttle (per IP + email).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=300

# --- Initial admin bootstrap (Phase 3) ---
# Used only by `npm run db:seed` to create the first ADMIN. Never used for
# public registration. Leave unset in production CI and provide via a secret.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Initial Admin

# --- Public widget API rate limits (Phase 4) ---
# Fixed-window counters kept in memory: SINGLE-INSTANCE ONLY. Behind multiple
# nodes the effective limit becomes max x nodes and resets with each restart;
# move to a shared store before scaling horizontally. All optional.
# Window length shared by every public bucket (milliseconds).
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
# Reads (visitor state, conversation list/detail).
PUBLIC_RATE_LIMIT_READ_MAX=300
# POST visitor initialization (prevents flooding the visitors table).
PUBLIC_RATE_LIMIT_INIT_MAX=20
# POST conversation creation (prevents conversation spam).
PUBLIC_RATE_LIMIT_CREATE_MAX=30
# POST message sends (per IP + website, same window as above).
PUBLIC_RATE_LIMIT_MESSAGE_MAX=60

# --- WebSocket rate limits (Phase 5) ---
# Same in-memory, SINGLE-INSTANCE trade-off as the public buckets above.
# `connect` is keyed per IP; `join` and `message` per socket (so they reset
# when a client reconnects — connection-level throttling is what `connect`
# covers). All optional, same window as PUBLIC_RATE_LIMIT_WINDOW_MS by default.
WS_RATE_LIMIT_WINDOW_MS=60000
WS_RATE_LIMIT_CONNECT_MAX=60
WS_RATE_LIMIT_JOIN_MAX=60
WS_RATE_LIMIT_MESSAGE_MAX=60

# --- Database (Phase 2) ---
# Consumed by docker-compose to provision the PostgreSQL container.
POSTGRES_DB=chatflow
POSTGRES_USER=chatflow
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_PORT=5432
# Consumed by the API and the Prisma CLI.
# Keep user/password/port/name in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql://chatflow:change-me-in-your-local-env@localhost:5432/chatflow?schema=public

# --- Widget dev: where the widget talks to the API (cross-origin on purpose) ---
VITE_API_URL=http://localhost:4000

# --- CORS (Phase 7) ---
# Browser-origin allowlist for the REST API (comma-separated, absolute http(s)
# URLs without a path). The visitor widget and demo storefront require the API
# to answer cross-origin requests, so their origins must be listed. Credentials
# are never enabled (auth is bearer JWT / visitor key, not cookies). When unset
# the API defaults to the local development origins:
#   http://localhost:5173 (dashboard), http://localhost:5174 (widget dev host),
#   http://localhost:5175 (demo storefront)
# Production must set this explicitly to the deployed dashboard + all enrolled
# customer-site origins; public website keys are NOT an authentication boundary.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- AI agent / Connect Agent (Phase 10) ---
# Which model backend powers automatic visitor replies. One of: mock | groq | openai.
# Leave unset to auto-detect: a configured GROQ_API_KEY selects the free Groq
# backend, else OPENAI_API_KEY selects OpenAI, else the built-in offline 'mock'.
# AI_PROVIDER=groq

# Groq free tier (recommended, OpenAI-compatible). Get a free key at
# https://console.groq.com/keys and paste it below, then restart the API.
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI (paid). Only used when AI_PROVIDER=openai or an OpenAI key is present
# without a Groq key.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Agent tuning (all optional, safe defaults shown).
# Max attempt count before an AI job is escalated to a human.
# AI_JOB_MAX_ATTEMPTS=3
# How long a worker may hold an un-finished job before it is reclaimable (ms).
# AI_JOB_LEASE_MS=120000
# How often the background worker polls for pending AI jobs (ms).
# AI_WORKER_INTERVAL_MS=1500
# Per-request model timeout (ms).
# AI_REQUEST_TIMEOUT_MS=20000
# Hard cap on a generated reply, in characters.
# AI_MAX_REPLY_LENGTH=2000
# Most FAQ entries fed to the model as grounding context (data-scope cap).
# AI_MAX_FAQ_CONTEXT=50
